{
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "admin.rythmosapp.com.br" }], "destination": "/admin.html" },
    { "source": "/index.html", "has": [{ "type": "host", "value": "admin.rythmosapp.com.br" }], "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), geolocation=()" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
